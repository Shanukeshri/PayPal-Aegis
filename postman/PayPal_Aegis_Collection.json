          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reauthorization endpoint responded', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
