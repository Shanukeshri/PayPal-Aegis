  "item": [
    {
      "name": "Sequence 0: System Health & Diagnostics",
      "item": [
        {
          "name": "0.1 Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://paypal-aegis.onrender.com/health",
              "protocol": "https",
              "host": ["paypal-aegis", "onrender", "com"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Service is healthy', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('HEALTHY');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sequence 1: Two-Step Order Creation & Day-3 Reauthorization",
      "item": [
        {
          "name": "1.1 Create Order (intent: AUTHORIZE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "PayPal-Request-Id", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intent\": \"AUTHORIZE\",\n  \"amount\": {\n    \"currency_code\": \"USD\",\n    \"value\": \"1250.00\"\n  },\n  \"description\": \"Milestone 1: Cloud Architecture Escrow Hold\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/safegate/orders",
              "host": ["{{baseUrl}}"],
              "path": ["safegate", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Order created with status 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('orderId', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Authorize Order (Lock 72h Hold)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "PayPal-Request-Id", "value": "{{idempotencyKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/safegate/orders/{{orderId}}/authorize",
              "host": ["{{baseUrl}}"],
              "path": ["safegate", "orders", "{{orderId}}", "authorize"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Authorization successful', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('activeAuthorizationId', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
