    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://paypal-aegis.onrender.com/api",
      "type": "string",
      "description": "Live Render endpoint (or http://localhost:3001/api for local development)"
    },
    {
      "key": "orderId",
      "value": "ORDER-SIM-INIT01",
      "type": "string"
    },
    {
      "key": "activeAuthorizationId",
      "value": "9LK88776655443321",
      "type": "string"
    },
    {
      "key": "mutatedAuthorizationId",
      "value": "AUTH-ROTATED-998822",
      "type": "string"
    },
    {
      "key": "disputeId",
      "value": "PP-D-882910",
      "type": "string"
    },
    {
      "key": "approvalId",
      "value": "hitl-appr-001",
      "type": "string"
    },
