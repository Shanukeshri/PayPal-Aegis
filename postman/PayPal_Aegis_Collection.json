    {
      "name": "Sequence 5: Zero-Lag Webhook Gateway & Raw CRC32 Ingestion",
      "item": [
        {
          "name": "5.1 Ingest Webhook (Raw CRC32 Checksum)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "paypal-transmission-id", "value": "TRANS-887711-POSTMAN" },
              { "key": "paypal-transmission-time", "value": "2026-11-20T12:00:00Z" },
              { "key": "paypal-auth-algo", "value": "SHA256withRSA" },
              { "key": "paypal-cert-url", "value": "https://api.sandbox.paypal.com/v1/notifications/certs/CERT-1234" },
              { "key": "paypal-transmission-sig", "value": "SIMULATED_SIG_BASE64_==" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"WH-EVENT-881920\",\n  \"event_type\": \"PAYMENT.AUTHORIZATION.CREATED\",\n  \"resource_type\": \"authorization\",\n  \"resource\": {\n    \"id\": \"AUTH-882299-DEMO\",\n    \"status\": \"CREATED\",\n    \"amount\": {\n      \"currency_code\": \"USD\",\n      \"value\": \"1250.00\"\n    }\n  },\n  \"links\": [\n    {\n      \"href\": \"https://api.sandbox.paypal.com/v2/payments/authorizations/AUTH-882299-DEMO\",\n      \"rel\": \"self\",\n      \"method\": \"GET\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/paypal",
              "host": ["{{baseUrl}}"],
              "path": ["webhooks", "paypal"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Webhook ingested or acknowledged without crash', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5.2 Simulate Webhook Event via Demo Gateway",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
