              "host": ["{{baseUrl}}"],
              "path": ["safegate", "authorizations", "{{activeAuthorizationId}}", "void"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Void endpoint responded successfully', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
