{
  "name": "paypal-aegis",
  "version": "1.0.0",
  "description": "PayPal Aegis — Autonomous Milestone Escrow, Delivery Verification & Dispute Compliance Operating System",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "cd frontend && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "start": "node dist/server.js",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx scripts/run-e2e-tests.ts",
    "test:browser": "tsx scripts/run-browser-tests.ts",
    "generate:pdf": "tsx scripts/generate-screenshots-pdf.ts",
    "generate:changed-pdf": "tsx scripts/generate-changed-pdf.ts"
  },
  "keywords": [
    "paypal",
    "aegis",
    "escrow",
    "dispute",
    "ai",
    "agent",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@openrouter/sdk": "^1.5.74",
    "@paypal/agent-toolkit": "^1.11.0",
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "crc-32": "^1.2.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "node-forge": "^1.3.1",
    "pdfkit": "^0.15.0",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.11",
    "@types/pdfkit": "^0.17.7",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.0.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
