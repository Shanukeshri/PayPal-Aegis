# ============================================
# PayPal Aegis — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
# All keys are OPTIONAL — the app runs in simulation
# mode with graceful fallbacks if any key is empty.
# ============================================

# --- PayPal Sandbox Credentials ---
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# --- PayPal Sandbox Buyer Credentials (for Judge Demo) ---
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# --- Server Configuration ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Redis (for webhook deduplication & idempotency cache) ---
# Leave blank to use in-memory fallback
REDIS_URL=

# --- Elasticsearch (for audit vault & kNN verification) ---
# Leave blank to use in-memory mock
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# --- Channel3 API (for product spec verification) ---
# Use promo code PAYPAL-HACKATHON-2026 for 20,000 free credits
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com

# --- OpenAI / LLM (for contract parsing & dispute triage) ---
# Leave blank to use deterministic mock parser
OPENAI_API_KEY=
LLM_MODEL=gpt-4o

# --- Render Workflows (for durable timers) ---
# Leave blank to use in-process setTimeout fallback
RENDER_WORKFLOW_API_KEY=

# --- HMAC Secret for Simulated Webhooks (Judge Demo) ---
# Auto-generated if blank
DEMO_HMAC_SECRET=aegis-demo-secret-key

# --- Application Secrets ---
SESSION_SECRET=change-me-in-production
HITL_APPROVAL_SECRET=change-me-in-production

